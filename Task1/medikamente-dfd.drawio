  <diagram id="diag_12" name="P6 Аналитика (To-Be)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_12" value="&lt;b&gt;DFD Процесс 6 (To-Be): Контур обезличенной аналитики (Data Lakehouse &amp; Privacy Gateway)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Целевое состояние: Privacy Gateway (k-anonymity), ClickHouse Data Lake, Apache Superset, исключение PII из аналитики&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="940" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_12_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Бизнес-аналитик (BA)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Доступ через Web BI&lt;br&gt;Без права скачивания сырых ПДн&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_12_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;ML / AI инженеры&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Обучение моделей LLM/ML&lt;br&gt;ТОЛЬКО на обезличенных сетах&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="250" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_12_12" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Руководство клиники&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Дашборды в BI Superset&lt;br&gt;Метрики в реальном времени&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="405" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_12_13" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 6.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[CDC Streaming]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;CDC &amp; ETL Экстракция&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Debezium + Kafka Connect&lt;br&gt;Потоковое извлечение изменений&lt;br&gt;из PostgreSQL (OLTP)&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="95" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_12_14" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 6.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Роскомнадзор 996]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Privacy &amp; Anonymization Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Удаление прямых идентификаторов&lt;br&gt;К-анонимизация (возрастные группы)&lt;br&gt;Дифференциальная приватность&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_12_15" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 6.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Zero Raw PII]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Витрины данных и BI&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Агрегаты в ClickHouse (OLAP)&lt;br&gt;Дашборды в Apache Superset&lt;br&gt;Тег: ANALYTICS_ANONYMIZED&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="405" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_12_16" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D1] Operational DBs (OLTP)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Strict Isolation]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Patient, Appointment, EHR DBs&lt;br&gt;Закрытый производственный контур&lt;br&gt;Прямой доступ аналитика ЗАПРЕЩЕН&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="105" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_12_17" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D2] Analytical Lake (ClickHouse)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[ClickHouse OLAP]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Колоночная СУБД для аналитики&lt;br&gt;100% обезличенные данные!&lt;br&gt;Агрегаты выручки, нагрузки, услуг&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="255" width="230" height="95" as="geometry" />
        </mxCell>
