        <mxCell id="flow_9_3" value="Сохранение кассового Excel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
