  <diagram id="diag_11" name="P6 Аналитика (As-Is)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_11" value="&lt;b&gt;DFD Процесс 6 (As-Is): Сбор аналитики, управленческая отчетность и бизнес-анализ&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Текущее состояние: прямой сбор неанонимизированных Excel файлов на ноутбук аналитика через SMB, Jupyter Notebook&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="880" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_11_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Бизнес-аналитик (BA)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Сотрудник IT-отдела&lt;br&gt;Рабочий ноутбук&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_11_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Руководство клиники&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Генеральный директор,&lt;br&gt;Главный врач&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_11_12" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 6.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Shadow Analytics]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Прямое копирование файлов&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Копирование Excel баз пациентов,&lt;br&gt;журналов и реестров анализов&lt;br&gt;по SMB на личный ноутбук&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="95" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_11_13" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 6.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Сырые ПДн в скриптах]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Расчеты в Jupyter Notebook&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Запуск локальных Python скриптов&lt;br&gt;обработки сырых данных (ФИО, суммы,&lt;br&gt;диагнозы) БЕЗ обезличивания&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="240" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_11_14" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 6.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Почтовая утечка]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Отправка отчетов по почте&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;P&amp;L, ABC-анализ в Excel&lt;br&gt;рассылаются через незащищенный&lt;br&gt;Exchange Mail Server&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="385" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_11_15" value="&lt;b style=&#x27;color:#dc2626;&#x27;&gt;[D1] Файловый сервер клиники&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Нет Data Lineage]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Папки: Pacients, Journals, Registry&lt;br&gt;Сырые файлы клиники за все годы&lt;br&gt;Доступны аналитику без ограничений&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="120" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cell_11_16" value="&lt;b style=&#x27;color:#dc2626;&#x27;&gt;[D2] Локальный диск ноутбука аналитика&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Критическая утечка]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Неконтролируемая теневая копия базы&lt;br&gt;Нет шифрования диска, нет DLP контроля,&lt;br&gt;риск выноса базы за пределы офиса&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="290" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="flow_11_1" value="Запуск скрипта копирования файлов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#475569;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="130" as="sourcePoint" />
            <mxPoint x="290" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_11_2" value="Выгрузка сырых Excel по SMB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
