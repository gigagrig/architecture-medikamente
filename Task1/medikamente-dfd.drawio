          </mxGeometry>
        </mxCell>
        <mxCell id="flow_8_7" value="Сохранение PDF в MinIO S3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="440" as="sourcePoint" />
            <mxPoint x="540" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_8_8" value="Push-уведомление в ЛК пациента" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="110" as="sourcePoint" />
            <mxPoint x="200" y="110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag_9" name="P5 Оплата (As-Is)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_9" value="&lt;b&gt;DFD Процесс 5 (As-Is): Оплата медицинских услуг и фискализация&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Текущее состояние: двойной учет (Excel + 1С), незащищенный протокол ККМ, файловая БД «1С:Бухгалтерия»&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="880" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_9_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Пациент (Patient)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Оплата на кассе&lt;br&gt;наличные / карта&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_9_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Кассир (Cashier)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;3 сотрудника кассы&lt;br&gt;Двойной учет&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_9_12" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;ККМ (Кассовый аппарат)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Контрольно-кассовая машина&lt;br&gt;Связь по TCP/IP OLE&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_9_13" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 5.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Двойной учет]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Прием платежа на кассе&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Расчет стоимости услуг,&lt;br&gt;прием средств, ввод в локальный&lt;br&gt;файл Excel кассира&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="110" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_9_14" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 5.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Незащищенный TCP/IP]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Пробитие чека через ККМ&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Передача команды в ККМ по TCP/IP&lt;br&gt;через устаревшую OLE-компоненту&lt;br&gt;без шифрования трафика&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="250" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_9_15" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 5.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Файловый режим 1С]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Проводка в «1С:Бухгалтерия»&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Ручное создание документа оплаты&lt;br&gt;в файловой базе 1С по сети SMB&lt;br&gt;(риск порчи базы при сбое сети)&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="390" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_9_16" value="&lt;b style=&#x27;color:#dc2626;&#x27;&gt;[D1] Локальный Excel кассира&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Shadow Data]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Файлы учета платежей на ПК кассиров&lt;br&gt;Не централизованы, нет контроля доступа,&lt;br&gt;рассинхронизация с бухгалтерией&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cell_9_17" value="&lt;b style=&#x27;color:#dc2626;&#x27;&gt;[D2] 1С:Бухгалтерия (файловая БД)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Риск потери данных]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Сетевой путь: \\Server\1C_Buh\&lt;br&gt;• Блокировки таблиц&lt;br&gt;• Нет шифрования сетевого трафика&lt;br&gt;• Риск повреждения при скачке питания&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="340" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="flow_9_1" value="Передача наличных / карты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#475569;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="135" as="sourcePoint" />
