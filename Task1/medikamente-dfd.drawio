  <diagram id="diag_6" name="P3 Прием и ЭМК (To-Be)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_6" value="&lt;b&gt;DFD Процесс 3 (To-Be): Защищенная электронная медицинская карта (ЭМК / EHR)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Целевое состояние: ABAC (доступ только на время визита), УКЭП врача, стандарты FHIR, S3 WORM, SIEM-аудит&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="940" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_6_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Пациент (Patient)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Субъект ПДн&lt;br&gt;Личный кабинет (ЛК)&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_6_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Врач (Doctor)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;АРМ врача&lt;br&gt;Аппаратный токен УКЭП&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="280" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_6_12" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 3.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Strict ABAC]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;ABAC авторизация доступа&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;OPA Policy Engine:&lt;br&gt;доступ к медкарте ТОЛЬКО при&lt;br&gt;наличии активной записи на прием&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="95" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_6_13" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 3.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[УКЭП / Минздрав 947н]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Ведение протокола (EHR)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Структурированный формат FHIR&lt;br&gt;Тег: PHI_SPECIAL_RESTRICTED&lt;br&gt;Подписание УКЭП врача (947н)&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_6_14" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 3.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[WORM / Immutability]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Иммутабельное архивирование&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Шифрование AES-256 (TDE)&lt;br&gt;Политика неизменяемости (WORM)&lt;br&gt;Запрет скрытого редактирования&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="405" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_6_15" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D1] EHR Clinical DB (PostgreSQL)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[PostgreSQL TDE]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Медицинские записи, диагнозы МКБ&lt;br&gt;Шифрование pgcrypto/TDE&lt;br&gt;Маскирование для не-врачей&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="105" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_6_16" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D2] Medical Docs (MinIO S3 SSE)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[SSE-KMS / WORM]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Подписанные PDF/A, снимки, ЭКГ&lt;br&gt;KMS Envelope Encryption&lt;br&gt;Object Lock (Immutability)&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="255" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_6_17" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D3] SIEM &amp; Audit Vault&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Неотслеживаемость исключена]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Полная фиксация каждого чтения!&lt;br&gt;Vector -&gt; OpenSearch -&gt; Wazuh&lt;br&gt;Срок хранения логов 5 лет&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="405" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_6_18" value="&lt;b style=&#x27;color:#15803d;font-size:11px;&#x27;&gt;🛡️ Гарантии безопасности&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 9px; color: #166534;&#x27;&gt;• Врач другой специальности&lt;br&gt;  НЕ МОЖЕТ открыть карту&lt;br&gt;• Каждая запись подписана&lt;br&gt;  личной УКЭП врача&lt;br&gt;• Невозможно подделать&lt;br&gt;  или удалить историю болезни&lt;br&gt;• 100% аудит просмотров&lt;br&gt;• Полное соответствие 323-ФЗ&lt;/font&gt;" style="shape=rectangle;rounded=1;dashed=1;dashPattern=4 2;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="180" width="160" height="195" as="geometry" />
        </mxCell>
        <mxCell id="flow_6_1" value="Запрос ЭМК пациента (mTLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
