  <diagram id="diag_5" name="P3 Прием и ЭМК (As-Is)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_5" value="&lt;b&gt;DFD Процесс 3 (As-Is): Проведение медицинского приёма и ведение медкарты&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Текущее состояние: файлы Word/Excel на файловом сервере, нет ЭЦП, нет версионирования, доступ открыт всей сети&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="880" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_5_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Пациент (Patient)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Очный прием в кабинете&lt;br&gt;Опрос, осмотр&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_5_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Врач (Doctor)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Медицинский специалист&lt;br&gt;ПК в локальной сети&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_5_12" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 3.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Нет аудита чтения]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Поиск медкарты в проводнике&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Открытие сетевой папки&lt;br&gt;\\Pacients\Pacient1-FIO-BD&lt;br&gt;Чтение Word/PDF файлов&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="100" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_5_13" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 3.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Нет юр. значимости]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Осмотр и оформление карты&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Внесение жалоб, диагноза (МКБ),&lt;br&gt;назначений в локальный файл Word&lt;br&gt;БЕЗ цифровой подписи (ЭЦП)&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="250" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_5_14" value="&lt;b style=&#x27;color:#1e40af;font-size:11px;&#x27;&gt;ПРОЦЕСС 3.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Бумажный след]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Печать заключений&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Вывод на локальный принтер&lt;br&gt;бумажного листа с диагнозом&lt;br&gt;и назначением лечения&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="390" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_5_15" value="&lt;b style=&#x27;color:#dc2626;&#x27;&gt;[D1] Файловый диск: Медкарты пациентов&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Критическая уязвимость]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Каталоги \\Pacients\Pacient-FIO-BD\&lt;br&gt;Файлы DOCX, PDF, XLSX, JPG&lt;br&gt;• Доступен любому ПК в офисе&lt;br&gt;• Нет неизменяемости (WORM)&lt;br&gt;• Нет журналирования (кто читал?)&lt;br&gt;• Нарушение 323-ФЗ и УЗ-1 (ФСТЭК № 21)&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="flow_5_1" value="Озвучивание жалоб,&lt;br&gt;анамнез, симптомы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
