        <mxCell id="5.3" parent="1" vertex="1" value="&lt;TABLE BORDER=&quot;0&quot; CELLBORDER=&quot;0&quot; CELLSPACING=&quot;0&quot; CELLPADDING=&quot;4&quot;&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Процесс 5.3&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:17px&quot;&gt;&lt;B&gt;Проводка в «1С:Бухгалтерия»&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Ручное создание документа оплаты&lt;BR/&gt;в файловой базе 1С по сети SMB&lt;BR/&gt;(риск порчи базы при сбое сети)&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;&lt;B&gt;Файловый режим 1С&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TABLE&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#b91c1c;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=10;">
