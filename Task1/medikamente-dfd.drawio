  <diagram id="diag_8" name="P4 Лаборатория (To-Be)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_8" value="&lt;b&gt;DFD Процесс 4 (To-Be): Защищенная интеграция с лабораторией (Lab API / mTLS)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Целевое состояние: деперсонализация биоматериала (barcode token), mTLS API контракты, Webhook, исключение утечек&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="940" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_8_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Пациент (Patient)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Сдает биоматериал&lt;br&gt;Результаты в ЛК&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_8_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Процедурный кабинет&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Медсестра (АРМ)&lt;br&gt;Маркировка пробирок&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="240" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_8_12" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Внешняя лаборатория&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Lab API Partner&lt;br&gt;Интеграция по стандарту&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_8_13" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 4.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Pseudonymization]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Деперсонализация заказа&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Генерация sample_uuid и barcode.&lt;br&gt;Лаборатории передается ТОЛЬКО код,&lt;br&gt;пол, возраст (без ФИО и паспорта)&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="95" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_8_14" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 4.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[mTLS / Zero Trust]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Защищенный API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Взаимная аутентификация mTLS&lt;br&gt;Строгий OpenAPI контракт&lt;br&gt;Валидация входящей схемы&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_8_15" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 4.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Tokenization Vault]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Реидентификация и доставка&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Сопоставление sample_uuid -&gt; patient_uuid&lt;br&gt;в закрытом изолированном Vault.&lt;br&gt;Тег: PHI_LAB_RESULT&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="405" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_8_16" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D1] Token Vault (HashiCorp)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Isolated Vault]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Таблица связки: barcode &lt;-&gt; patient_uuid&lt;br&gt;Доступна ТОЛЬКО Lab Service&lt;br&gt;Изолирована от внешнего контура&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="105" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_8_17" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D2] Lab Orders DB (PostgreSQL)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Anonymized Orders]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Статусы заказов, даты готовности&lt;br&gt;Шифрование TDE&lt;br&gt;Без персональных данных&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="255" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_8_18" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D3] Results Storage (MinIO S3)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[SSE-KMS / RLS]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Зашифрованные PDF бланки&lt;br&gt;SSE-KMS шифрование&lt;br&gt;Доступ пациенту только к своим!&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="405" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_8_19" value="&lt;b style=&#x27;color:#15803d;font-size:11px;&#x27;&gt;🛡️ Принципы защиты&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 9px; color: #166534;&#x27;&gt;• Партнер НЕ ЗНАЕТ ФИО&lt;br&gt;  пациента (только barcode)&lt;br&gt;• Никаких Excel реестров&lt;br&gt;• Никаких пересылок по mail&lt;br&gt;• Двусторонний mTLS&lt;br&gt;• Исключен просмотр чужих&lt;br&gt;  анализов другими клиентами&lt;/font&gt;" style="shape=rectangle;rounded=1;dashed=1;dashPattern=4 2;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="180" width="160" height="195" as="geometry" />
        </mxCell>
        <mxCell id="flow_8_1" value="Создание заказа на исследование" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
