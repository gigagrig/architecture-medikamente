        <mxCell id="flow_11_4" value="Кэширование CSV на диск ПК" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
