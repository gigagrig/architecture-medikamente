  <diagram id="dfd-p3-consultation-as-is" name="P3 Приём и ЭМК (As-Is)">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" background="#ffffff" pageWidth="1554" pageHeight="916">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header" parent="1" vertex="1" value="&lt;b style=&quot;font-size:22px&quot;&gt;DFD Процесс 3 (As-Is): Проведение медицинского приёма и ведение медкарты&lt;/b&gt;&lt;br&gt;Текущее состояние: файлы Word/Excel на файловом сервере, нет ЭЦП, нет версионирования, доступ открыт всей сети&lt;br&gt;&lt;br&gt;Стрелка: направление передачи данных. Красный: уязвимость. Зелёный: мера защиты. Синий: внешний участник." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontFamily=DejaVu Sans;fontColor=#0f172a;whiteSpace=wrap;">
          <mxGeometry x="28" y="12" width="1498" height="111" as="geometry" />
        </mxCell>
        <mxCell id="E1" parent="1" vertex="1" value="&lt;TABLE BORDER=&quot;0&quot; CELLBORDER=&quot;0&quot; CELLSPACING=&quot;0&quot; CELLPADDING=&quot;4&quot;&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Внешняя сущность E1&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:17px&quot;&gt;&lt;B&gt;Пациент (Patient)&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Очный прием в кабинете&lt;BR/&gt;Опрос, осмотр&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TABLE&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0369a1;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=10;">
