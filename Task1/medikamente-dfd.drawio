          <mxGeometry x="28.0" y="690.0" width="294.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="5.1" parent="1" vertex="1" value="&lt;TABLE BORDER=&quot;0&quot; CELLBORDER=&quot;0&quot; CELLSPACING=&quot;0&quot; CELLPADDING=&quot;4&quot;&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Процесс 5.1&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:17px&quot;&gt;&lt;B&gt;Billing &amp;amp; Invoicing Service&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Формирование инвойса по заказу.&lt;BR/&gt;Связка order_uuid + сумма.&lt;BR/&gt;Маскирование мед. диагнозов&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;&lt;B&gt;Data Minimization&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TABLE&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#166534;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=10;">
          <mxGeometry x="604.0" y="146.0" width="294.0" height="144.0" as="geometry" />
        </mxCell>
        <mxCell id="5.2" parent="1" vertex="1" value="&lt;TABLE BORDER=&quot;0&quot; CELLBORDER=&quot;0&quot; CELLSPACING=&quot;0&quot; CELLPADDING=&quot;4&quot;&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Процесс 5.2&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:17px&quot;&gt;&lt;B&gt;Payment Gateway (PCI DSS)&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Токенизация карт в банке.&lt;BR/&gt;Клиника НЕ хранит данные карт!&lt;BR/&gt;TLS 1.3 + криптоподпись webhook&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;&lt;B&gt;PCI DSS Level 1&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TABLE&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#166534;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=10;">
