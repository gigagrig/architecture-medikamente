        </mxCell>
        <mxCell id="5.3" parent="1" vertex="1" value="&lt;TABLE BORDER=&quot;0&quot; CELLBORDER=&quot;0&quot; CELLSPACING=&quot;0&quot; CELLPADDING=&quot;4&quot;&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Процесс 5.3&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:17px&quot;&gt;&lt;B&gt;Fiscal &amp;amp; 1C Sync Service&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Автоматическая фискализация&lt;BR/&gt;(54-ФЗ),&lt;BR/&gt;электронный чек по SMS/email,&lt;BR/&gt;событие в Kafka для&lt;BR/&gt;клиент-серверной 1С&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;&lt;B&gt;54-ФЗ / Kafka&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TABLE&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#166534;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=10;">
