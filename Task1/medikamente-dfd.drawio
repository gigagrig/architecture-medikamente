  <diagram id="dfd-p1-registration-to-be" name="P1 Регистрация (To-Be)">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" background="#ffffff" pageWidth="1572" pageHeight="1054">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header" parent="1" vertex="1" value="&lt;b style=&quot;font-size:22px&quot;&gt;DFD Процесс 1 (To-Be): Защищенная регистрация и онбординг пациента&lt;/b&gt;&lt;br&gt;Целевое состояние: Data Minimization, TLS 1.3, Keycloak RBAC/ABAC, PostgreSQL TDE, MinIO S3 SSE-KMS, тегирование PII&lt;br&gt;&lt;br&gt;Стрелка: направление передачи данных. Красный: уязвимость. Зелёный: мера защиты. Синий: внешний участник." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontFamily=DejaVu Sans;fontColor=#0f172a;whiteSpace=wrap;">
          <mxGeometry x="28" y="12" width="1516" height="111" as="geometry" />
        </mxCell>
        <mxCell id="E1" parent="1" vertex="1" value="&lt;TABLE BORDER=&quot;0&quot; CELLBORDER=&quot;0&quot; CELLSPACING=&quot;0&quot; CELLPADDING=&quot;4&quot;&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Внешняя сущность E1&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:17px&quot;&gt;&lt;B&gt;Пациент (Client)&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Web-портал / App / Планшет&lt;BR/&gt;Самостоятельный ввод&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TABLE&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0369a1;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=10;">
          <mxGeometry x="28.0" y="165.0" width="294.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="E2" parent="1" vertex="1" value="&lt;TABLE BORDER=&quot;0&quot; CELLBORDER=&quot;0&quot; CELLSPACING=&quot;0&quot; CELLPADDING=&quot;4&quot;&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Внешняя сущность E2&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:17px&quot;&gt;&lt;B&gt;Ресепшен (Staff)&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;АРМ сотрудника ресепшена&lt;BR/&gt;Роль: Receptionist (RBAC)&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TABLE&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0369a1;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=10;">
          <mxGeometry x="28.0" y="391.0" width="294.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="1.1" parent="1" vertex="1" value="&lt;TABLE BORDER=&quot;0&quot; CELLBORDER=&quot;0&quot; CELLSPACING=&quot;0&quot; CELLPADDING=&quot;4&quot;&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Процесс 1.1&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:17px&quot;&gt;&lt;B&gt;Минимизированный сбор ПДн&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;Исключены место работы/учебы&lt;BR/&gt;Только необходимые ФИО, телефон,&lt;BR/&gt;паспорт и электронное ИДС&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;TR&gt;&lt;TD&gt;&lt;FONT style=&quot;font-size:14px&quot;&gt;&lt;B&gt;Data Minimization&lt;/B&gt;&lt;/FONT&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TABLE&gt;" style="shape=rectangle;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#166534;strokeWidth=2;fontColor=#0f172a;fontSize=14;fontFamily=DejaVu Sans;align=center;verticalAlign=middle;spacing=10;">
          <mxGeometry x="642.0" y="146.0" width="330.0" height="144.0" as="geometry" />
        </mxCell>
