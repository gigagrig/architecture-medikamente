<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.5">
  <diagram id="diag_1" name="P1 Регистрация (As-Is)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_1" value="&lt;b&gt;DFD Процесс 1 (As-Is): Первичная регистрация пациента и оформление документов&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Текущее состояние: ручной сбор избыточных ПДн, хранение сканов на общем сетевом диске без шифрования и разграничения прав&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="880" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_1_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Пациент (Patient)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Субъект ПДн&lt;br&gt;Очное обращение&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_1_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Ресепшен (Receptionist)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Сотрудник клиники&lt;br&gt;3 человека&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_1_12" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 1.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Избыточный сбор]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Сбор ПДн и анкеты&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Ручное заполнение бланка:&lt;br&gt;паспорт, контакты, работа,&lt;br&gt;хронические заболевания&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="95" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_1_13" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 1.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Нет контроля прав]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Ведение Excel-реестра&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Внесение данных пациента&lt;br&gt;в единый неструктурированный&lt;br&gt;файл Patients.xlsx&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="230" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_1_14" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 1.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Теневые сканы]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Сканирование документов&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;МФУ -&gt; скан паспорта,&lt;br&gt;договора и согласия&lt;br&gt;в JPG / PDF без учета&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="365" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_1_15" value="&lt;b style=&#x27;color:#dc2626;&#x27;&gt;[D1] Файловый диск: Patients.xlsx&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Риск УЗ-1]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Общий каталог SMB/CIFS&lt;br&gt;Доступен всем доменным пользователям&lt;br&gt;Отсутствует шифрование и аудит&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cell_1_16" value="&lt;b style=&#x27;color:#dc2626;&#x27;&gt;[D2] Файловый диск: \\Pacients\*&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Нарушение 152-ФЗ]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Папки: Pacient1-FIO-BD&lt;br&gt;Сканы паспортов, согласий, анкет&lt;br&gt;Нет версионирования и удаления&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="flow_1_1" value="Бумажная анкета:&lt;br&gt;ФИО, паспорт, телефон,&lt;br&gt;место работы/учебы, анамнез" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="135" as="sourcePoint" />
            <mxPoint x="290" y="135" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_1_2" value="Выдача бланков&lt;br&gt;и договоров" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#475569;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="280" as="sourcePoint" />
            <mxPoint x="130" y="185" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_1_3" value="Ручной ввод&lt;br&gt;ФИО и контактов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#475569;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="310" as="sourcePoint" />
            <mxPoint x="290" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_1_4" value="Сканирование&lt;br&gt;документов на МФУ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#475569;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="340" as="sourcePoint" />
            <mxPoint x="290" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_1_5" value="Запись строки&lt;br&gt;в открытый Excel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="260" as="sourcePoint" />
            <mxPoint x="600" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_1_6" value="Сохранение JPG/PDF&lt;br&gt;по SMB без шифрования" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="410" as="sourcePoint" />
            <mxPoint x="600" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag_2" name="P1 Регистрация (To-Be)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_2" value="&lt;b&gt;DFD Процесс 1 (To-Be): Защищенная регистрация и онбординг пациента&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Целевое состояние: Data Minimization, TLS 1.3, Keycloak RBAC/ABAC, PostgreSQL TDE, MinIO S3 SSE-KMS, тегирование PII&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="940" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_2_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Пациент (Client)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Web-портал / App / Планшет&lt;br&gt;Самостоятельный ввод&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_2_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Ресепшен (Staff)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;АРМ сотрудника ресепшена&lt;br&gt;Роль: Receptionist (RBAC)&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="280" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_2_12" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 1.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Data Minimization]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Минимизированный сбор ПДн&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Исключены место работы/учебы&lt;br&gt;Только необходимые ФИО, телефон,&lt;br&gt;паспорт и электронное ИДС&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="95" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_2_13" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 1.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[OAuth2 / mTLS]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Аутентификация и валидация&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Kong API Gateway + WAF&lt;br&gt;Keycloak IdP (JWT Bearer)&lt;br&gt;Проверка согласия на обработку&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_2_14" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 1.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Data Tagging Engine]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Псевдонимизация и тегирование&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Генерация patient_uuid&lt;br&gt;Маркировка: PII_CONFIDENTIAL&lt;br&gt;Политики OPA + OpenMetadata&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="400" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_2_15" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D1] Patient DB (PostgreSQL)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[AES-256 / УЗ-1]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Шифрование TDE / pgcrypto&lt;br&gt;Row-Level Security (RLS)&lt;br&gt;UUID связка, аудит чтения&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="110" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_2_16" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D2] Doc Storage (MinIO S3)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Vault KMS]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Электронные согласия и сканы&lt;br&gt;Server-Side Encryption (SSE-KMS)&lt;br&gt;Object Versioning &amp; Retention&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="260" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_2_17" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D3] Audit &amp; Event Store (Kafka)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Vector / OpenSearch]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Централизованный Audit Log&lt;br&gt;Шина сообщений Kafka mTLS&lt;br&gt;Data Lineage фиксация&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="410" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_2_18" value="&lt;b style=&#x27;color:#15803d;font-size:11px;&#x27;&gt;🛡️ Меры безопасности To-Be&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 9px; color: #166534;&#x27;&gt;• TLS 1.3 шифрование&lt;br&gt;• RBAC/ABAC доступ&lt;br&gt;• Токенизация patient_id&lt;br&gt;• Тегирование PII&lt;br&gt;• Автоматический аудит&lt;br&gt;• Поддержка ст. 21 152-ФЗ&lt;br&gt;  (удаление по запросу)&lt;/font&gt;" style="shape=rectangle;rounded=1;dashed=1;dashPattern=4 2;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="180" width="160" height="190" as="geometry" />
        </mxCell>
        <mxCell id="flow_2_1" value="HTTPS TLS 1.3:&lt;br&gt;ФИО, контакты, паспорт, ИДС" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="140" as="sourcePoint" />
            <mxPoint x="250" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_2_2" value="Авторизованный доступ&lt;br&gt;к АРМ (Keycloak 2FA)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="310" as="sourcePoint" />
            <mxPoint x="250" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_2_3" value="Передача профиля&lt;br&gt;через API Gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="190" as="sourcePoint" />
            <mxPoint x="360" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_2_4" value="Обогащение тегами&lt;br&gt;и генерация UUID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="345" as="sourcePoint" />
            <mxPoint x="360" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_2_5" value="Запись карточки&lt;br&gt;пациента (TDE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="150" as="sourcePoint" />
            <mxPoint x="540" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_2_6" value="Загрузка сканов&lt;br&gt;с тегом PII_FILE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="295" as="sourcePoint" />
            <mxPoint x="540" y="295" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_2_7" value="Событие: PatientCreated&lt;br&gt;(Audit Lineage)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="450" as="sourcePoint" />
            <mxPoint x="540" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag_3" name="P2 Запись (As-Is)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_3" value="&lt;b&gt;DFD Процесс 2 (As-Is): Запись пациента на приём к специалисту&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Текущее состояние: открытые Excel-файлы расписаний по докторам, раскрытие врачебной тайны, коллизии блокировок&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="880" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_3_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Пациент (Patient)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Обращение по телефону&lt;br&gt;или лично на стойку&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_3_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Ресепшен (Receptionist)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Администратор ведет запись&lt;br&gt;в файлы расписаний&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_3_12" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Врач (Doctor)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Медицинский специалист&lt;br&gt;15 сотрудников&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_3_13" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 2.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Коллизии файлов]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Проверка расписания&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Поиск свободного слота&lt;br&gt;в открытом файле Excel&lt;br&gt;Journal-Doctor-FIO.xlsx&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="130" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_3_14" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 2.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Утечка врачебной тайны]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Внесение записи на прием&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Ручной ввод ФИО, телефона,&lt;br&gt;специальности и причины&lt;br&gt;визита в ячейку таблицы&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="290" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_3_15" value="&lt;b style=&#x27;color:#dc2626;&#x27;&gt;[D1] Файловый диск: \\Journals\*&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Критический риск]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Таблицы: Journal-Doctor-FIO.xlsx&lt;br&gt;Каждый врач и администратор имеет&lt;br&gt;доступ к расписанию ВСЕХ врачей клиники!&lt;br&gt;Нарушение ст. 13 323-ФЗ (врачебная тайна)&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="200" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="flow_3_1" value="Запрос записи: специальность,&lt;br&gt;ФИО, телефон, симптомы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="140" as="sourcePoint" />
            <mxPoint x="290" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_3_2" value="Открытие файла Excel&lt;br&gt;доктора через SMB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#475569;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="275" as="sourcePoint" />
            <mxPoint x="290" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_3_3" value="Выбор свободного&lt;br&gt;слота времени" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#475569;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="390" y="225" as="sourcePoint" />
            <mxPoint x="390" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_3_4" value="Сохранение файла&lt;br&gt;Journal-Doctor-FIO.xlsx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="320" as="sourcePoint" />
            <mxPoint x="590" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_3_5" value="Врач открывает расписание&lt;br&gt;(и может открыть чужие файлы!)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="430" as="sourcePoint" />
            <mxPoint x="590" y="310" as="targetPoint" />
