  </diagram>
  <diagram id="diag_10" name="P5 Оплата (To-Be)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_10" value="&lt;b&gt;DFD Процесс 5 (To-Be): Защищенный платежный шлюз и фискализация (PCI DSS / 54-ФЗ)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Целевое состояние: Payment Gateway, СБП/Эквайринг (без хранения карт), ОФД, 1С клиент-сервер по API/Kafka&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="940" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_10_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Пациент (Client)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Оплата в App / ЛК / СБП&lt;br&gt;или терминал на кассе&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_10_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Кассир / Ресепшен&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;АРМ кассира (RBAC)&lt;br&gt;Формирование счетов&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="240" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_10_12" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Банк-эквайер / ОФД&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Внешний шлюз эквайринга&lt;br&gt;Оператор фискальных данных&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_10_13" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 5.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Data Minimization]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Billing &amp; Invoicing Service&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Формирование инвойса по заказу.&lt;br&gt;Связка order_uuid + сумма.&lt;br&gt;Маскирование мед. диагнозов&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="95" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_10_14" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 5.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[PCI DSS Level 1]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Payment Gateway (PCI DSS)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Токенизация карт в банке.&lt;br&gt;Клиника НЕ хранит данные карт!&lt;br&gt;TLS 1.3 + криптоподпись webhook&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_10_15" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 5.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[54-ФЗ / Kafka]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Fiscal &amp; 1C Sync Service&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Автоматическая фискализация (54-ФЗ),&lt;br&gt;электронный чек по SMS/email,&lt;br&gt;событие в Kafka для клиент-серверной 1С&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="405" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_10_16" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D1] Billing DB (PostgreSQL)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[TDE / RLS]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Счета, транзакции, фискальные теги&lt;br&gt;Шифрование TDE&lt;br&gt;Тег: FINANCIAL_CONFIDENTIAL&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="105" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_10_17" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D2] Audit &amp; Kafka Pipeline&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[mTLS Kafka]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Топик billing.payments.completed&lt;br&gt;Асинхронная доставка в бухгалтерию&lt;br&gt;Идемпотентность транзакций&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="255" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_10_18" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D3] 1С (Клиент-Сервер)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Enterprise 1C]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;PostgreSQL база данных 1С&lt;br&gt;Интеграция по REST API/Kafka&lt;br&gt;Исключены файловые блокировки&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="405" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_10_19" value="&lt;b style=&#x27;color:#15803d;font-size:11px;&#x27;&gt;🛡️ Принципы защиты&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 9px; color: #166534;&#x27;&gt;• Данные карт НЕ попадают&lt;br&gt;  на сервер клиники (СБП)&lt;br&gt;• Бухгалтерия видит только код&lt;br&gt;  услуги (без диагнозов!)&lt;br&gt;• Исключен теневой Excel&lt;br&gt;• Электронный чек в ОФД&lt;br&gt;• Клиент-серверная 1С&lt;/font&gt;" style="shape=rectangle;rounded=1;dashed=1;dashPattern=4 2;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="180" width="160" height="195" as="geometry" />
        </mxCell>
        <mxCell id="flow_10_1" value="Оплата: СБП / Карта / ЛК (TLS 1.3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
