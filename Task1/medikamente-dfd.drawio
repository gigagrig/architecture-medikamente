  <diagram id="diag_7" name="P4 Лаборатория (As-Is)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_7" value="&lt;b&gt;DFD Процесс 4 (As-Is): Направление и получение анализов из лаборатории&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Текущее состояние: открытый Exchange e-mail, незащищенные реестры анализов, отсутствие деперсонализации биоматериала&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="880" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_7_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Пациент (Patient)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Сдает биоматериал&lt;br&gt;в процедурном кабинете&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_7_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Медсестра / Ресепшен&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Оформляет суточный реестр&lt;br&gt;и отправляет пробирки&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_7_12" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Внешняя лаборатория&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Партнерская лаборатория&lt;br&gt;Обмен через Exchange / файлы&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_7_13" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 4.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Нет шифрования]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Ведение реестра анализов&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Внесение ФИО, даты, видов&lt;br&gt;исследований в Excel&lt;br&gt;RegistryByDate.xlsx&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="130" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_7_14" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 4.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Нарушение тайны]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Передача реестра партнеру&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Отправка списка пациентов&lt;br&gt;и забор пробирок курьером&lt;br&gt;без деперсонализации&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="285" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_7_15" value="&lt;b style=&#x27;color:#991b1b;font-size:11px;&#x27;&gt;ПРОЦЕСС 4.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Открытый e-mail]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Прием результатов (e-mail)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Получение PDF/XLS по Exchange,&lt;br&gt;ручное копирование в папки&lt;br&gt;пациентов на файловом диске&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="415" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_7_16" value="&lt;b style=&#x27;color:#dc2626;&#x27;&gt;[D1] Файловый диск: Laboratory Registry&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Утечка спецкатегорий]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Каталоги \\Laboratory Registry\RegistryByDate.xlsx&lt;br&gt;• Доступен всем сотрудникам&lt;br&gt;• Содержит ФИО + ВИЧ, гепатиты, онкомаркеры!&lt;br&gt;• Нарушение ст. 10 152-ФЗ и ст. 13 323-ФЗ&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="190" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="flow_7_1" value="Забор биоматериала (ФИО на пробирке)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=1.5;fontColor=#dc2626;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
