      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag_4" name="P2 Запись (To-Be)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_4" value="&lt;b&gt;DFD Процесс 2 (To-Be): Автоматизированная запись на прием с RBAC/ABAC&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 11px; color: #64748b;&#x27;&gt;Целевое состояние: ЛК пациента, RBAC изоляция журналов врачей, Kafka нотификации, токенизация appointments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=15;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="940" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_4_10" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Пациент (Client)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Web-портал / Мобильное App&lt;br&gt;Автономная запись 24/7&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_4_11" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Ресепшен (Staff)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;АРМ ресепшена&lt;br&gt;Только общие слоты&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="240" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_4_12" value="&lt;b&gt;[ВНЕШНЯЯ СУЩНОСТЬ]&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 13px;&#x27;&gt;Врач (Doctor)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;АРМ врача (RBAC/ABAC)&lt;br&gt;Видит ТОЛЬКО своих пациентов&lt;/font&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="390" width="170" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cell_4_13" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 2.1 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Data Minimization]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Запрос расписания (API)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Фильтрация доступных слотов&lt;br&gt;Без раскрытия чужих данных&lt;br&gt;Rate limiting + WAF&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="100" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_4_14" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 2.2 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Zero Collisions]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Бронирование визита&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Appointment Service (OLTP)&lt;br&gt;Атомарная транзакция в PostgreSQL&lt;br&gt;Тег: PHI_APPOINTMENT&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_4_15" value="&lt;b style=&#x27;color:#166534;font-size:11px;&#x27;&gt;ПРОЦЕСС 2.3 &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Privacy-preserving]&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&#x27;font-size: 12px;&#x27;&gt;Оповещения и напоминания&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #334155;&#x27;&gt;Notification Service (Kafka)&lt;br&gt;SMS/Push за 24ч до приема&lt;br&gt;Без раскрытия диагноза&lt;/font&gt;" style="shape=rect;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="400" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_4_16" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D1] Appointment DB (PostgreSQL)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[TDE / RLS]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Слоты, patient_uuid, doctor_id&lt;br&gt;ABAC правила доступа (OPA)&lt;br&gt;Исключены коллизии блокировок&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="170" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_4_17" value="&lt;b style=&#x27;color:#16a34a;&#x27;&gt;[D2] Message Broker (Kafka mTLS)&lt;/b&gt; &lt;span style=&#x27;font-size:9px;&#x27;&gt;[Audit &amp; Events]&lt;/span&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 10px; color: #475569;&#x27;&gt;Топик appointments.events&lt;br&gt;События: Created, Confirmed, Cancelled&lt;br&gt;Шифрование payload + audit&lt;/font&gt;" style="shape=partialRectangle;top=1;bottom=1;left=1;right=0;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="340" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cell_4_18" value="&lt;b style=&#x27;color:#15803d;font-size:11px;&#x27;&gt;🛡️ Защитные механизмы&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size: 9px; color: #166534;&#x27;&gt;• Врач видит ТОЛЬКО&lt;br&gt;  свое расписание (ABAC)&lt;br&gt;• Пациент видит только&lt;br&gt;  свободные временные окна&lt;br&gt;• Нет утечки диагнозов&lt;br&gt;• Логирование в SIEM&lt;br&gt;• Высокая доступность&lt;/font&gt;" style="shape=rectangle;rounded=1;dashed=1;dashPattern=4 2;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#14532d;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="810" y="190" width="155" height="180" as="geometry" />
        </mxCell>
        <mxCell id="flow_4_1" value="HTTPS TLS 1.3: Поиск врача/слота" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="130" as="sourcePoint" />
            <mxPoint x="250" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_4_2" value="Создание записи с ресепшена" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="280" as="sourcePoint" />
            <mxPoint x="250" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_4_3" value="Запрос журнала (только свой doctor_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="430" as="sourcePoint" />
            <mxPoint x="250" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_4_4" value="Выбор интервала" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="195" as="sourcePoint" />
            <mxPoint x="360" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_4_5" value="Фиксация брони в БД" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="270" as="sourcePoint" />
            <mxPoint x="540" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_4_6" value="Инициация события" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="345" as="sourcePoint" />
            <mxPoint x="360" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow_4_7" value="Публикация брони в Kafka" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#16a34a;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
